{
  "name": "ai-resume-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20 <21",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:web": "pnpm --filter @jobos/web dev",
    "dev:extension": "pnpm --filter @jobos/extension dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
