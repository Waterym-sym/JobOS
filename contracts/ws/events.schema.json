{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-resume-os.local/contracts/ws/events.schema.json",
  "x-status": "v1",
  "x-doc": "docs/architecture/21-浏览器扩展集成协议.md §4",
  "title": "Extension -> Server Events (8)",
  "description": "扩展上报全集 8 个事件。所有上报按 source+ext_id / ext_msg_id 幂等。业务侧领域事件（screen.completed 等 8 类）为服务端内部事件，不经 WebSocket，不在本契约。company.updated 由 capture_company 命令触发的公司主页被动读取产生。",
  "oneOf": [
    { "$ref": "#/$defs/capturePhase" },
    { "$ref": "#/$defs/jobCaptured" },
    { "$ref": "#/$defs/jobUpdated" },
    { "$ref": "#/$defs/companyUpdated" },
    { "$ref": "#/$defs/captureCompleted" },
    { "$ref": "#/$defs/captureError" },
    { "$ref": "#/$defs/chatEvent" },
    { "$ref": "#/$defs/fillCompleted" }
  ],
  "$defs": {
    "baseEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "kind", "id", "type", "payload"],
      "properties": {
        "v": { "const": 1 },
        "kind": { "const": "event" },
        "id": { "type": "string" },
        "type": { "type": "string" },
        "capture_id": { "type": ["string", "null"] },
        "command_id": { "type": ["string", "null"] },
        "ts": { "type": "string", "format": "date-time" },
        "payload": { "type": "object" }
      }
    },
    "capturePhase": {
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "capture.phase" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["phase", "done", "total", "current"],
              "properties": {
                "phase": { "type": "string", "enum": ["list", "detail", "company"] },
                "done": { "type": "integer", "minimum": 0 },
                "total": { "type": "integer", "minimum": 0 },
                "current": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "jobCaptured": {
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "job.captured" },
            "payload": { "$ref": "./raw-job.schema.json" }
          }
        }
      ]
    },
    "jobUpdated": {
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "job.updated" },
            "payload": { "$ref": "./raw-job.schema.json" }
          }
        }
      ]
    },
    "companyUpdated": {
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "company.updated" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "ext_company_id", "sections", "captured_at"],
              "properties": {
                "source": { "const": "boss" },
                "ext_company_id": { "type": "string", "minLength": 1 },
                "name": { "type": "string" },
                "sections": {
                  "type": "object",
                  "description": "公司主页分区被动提取结果，键为分区名（intro/address/industry 等），值为文本或结构化数据"
                },
                "raw_json": { "type": "object" },
                "captured_at": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      ]
    },
    "captureCompleted": {
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "capture.completed" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["capture_id", "stats", "finished_at"],
              "properties": {
                "capture_id": { "type": "string" },
                "stats": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["success", "dup", "risk_halted"],
                  "properties": {
                    "success": { "type": "integer", "minimum": 0 },
                    "dup": { "type": "integer", "minimum": 0 },
                    "risk_halted": { "type": "boolean" }
                  }
                },
                "finished_at": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      ]
    },
    "captureError": {
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "capture.error" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "recoverable", "risk"],
              "properties": {
                "code": { "type": "string" },
                "message": { "type": "string" },
                "recoverable": { "type": "boolean" },
                "risk": {
                  "type": "boolean",
                  "description": "true 时批次必须自动 risk_halted 并等待人工恢复，不得自动重试"
                }
              }
            }
          }
        }
      ]
    },
    "chatEvent": {
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "chat.event" },
            "payload": { "$ref": "./chat-event.schema.json" }
          }
        }
      ]
    },
    "fillCompleted": {
      "allOf": [
        { "$ref": "#/$defs/baseEvent" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "fill.completed" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["application_id", "modules_filled", "user_confirmed"],
              "properties": {
                "application_id": { "type": "string", "format": "uuid" },
                "modules_filled": {
                  "type": "array",
                  "items": { "type": "string", "enum": ["advantage", "work_experiences", "projects", "skills"] }
                },
                "skipped_redline": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "载荷中出现但被扩展拒绝写入的红线字段（company/title/dates/degree）"
                },
                "user_confirmed": { "const": true, "description": "未当场人工确认不得上报成功" }
              }
            }
          }
        }
      ]
    }
  }
}
