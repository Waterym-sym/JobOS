{
  "manifest_version": 3,
  "name": "JobOS 岗位池补全桥",
  "version": "0.3.0",
  "description": "JobOS 本机桥：岗位池按 URL 补全 BOSS 详情页/公司页（只读、人工节奏）。列表采集请使用 boss-helper 扩展。",
  "permissions": ["storage", "scripting", "tabs", "alarms"],
  "host_permissions": ["https://www.zhipin.com/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:8788"
  },
  "action": {
    "default_title": "JobOS 岗位池补全桥"
  }
}