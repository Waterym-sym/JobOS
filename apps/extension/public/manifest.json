{
  "manifest_version": 3,
  "name": "JobOS Local Bridge",
  "version": "0.1.0",
  "description": "Local-only bridge scaffold. Collection capabilities are not enabled yet.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:8788"
  },
  "action": {
    "default_title": "JobOS Local Bridge"
  }
}
