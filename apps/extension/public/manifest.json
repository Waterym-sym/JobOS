{
  "manifest_version": 3,
  "name": "JobOS Local Bridge",
  "version": "0.2.2",
  "description": "Local-only bridge: pool enrich capture from BOSS pages (read-only, human-paced).",
  "permissions": ["storage", "scripting", "tabs", "alarms"],
  "host_permissions": ["https://www.zhipin.com/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:8788"
  },
  "action": {
    "default_title": "JobOS Local Bridge"
  }
}